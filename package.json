{
  "name": "apple-icloud-mcp",
  "version": "2.0.0",
  "description": "MCP server for Apple iCloud Mail, Calendar, Reminders and Contacts",
  "type": "module",
  "main": "dist/bin/stdio.js",
  "bin": { "apple-icloud-mcp": "dist/bin/stdio.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "tsx src/bin/stdio.ts",
    "serve": "node dist/bin/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "ical.js": "2.2.1",
    "imapflow": "1.7.2",
    "mailparser": "3.9.15",
    "nodemailer": "9.0.5",
    "tsdav": "2.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "html-to-text": "10.0.1"
  }
}
