{
  "name": "apple-icloud-mcp",
  "version": "2.0.0",
  "description": "MCP server for Apple iCloud Mail, Calendar, Reminders and Contacts",
  "type": "module",
  "main": "dist/bin/stdio.js",
  "bin": {
    "apple-icloud-mcp": "dist/bin/stdio.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "tsx src/bin/stdio.ts",
    "serve": "node dist/bin/stdio.js",
    "start:http": "tsx src/bin/http.ts",
    "serve:http": "node dist/bin/http.js",
    "cli": "node dist/bin/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "ical.js": "2.2.1",
    "imapflow": "1.7.2",
    "mailparser": "3.9.36",
    "nodemailer": "10.0.14",
    "tsdav": "2.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "22.10.2",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "html-to-text": "10.0.1",
    "ip-address": "10.7.1",
    "qs": "6.16.0"
  }
}
