# ---- 账号 1（必填）----
# Apple ID 邮箱：用于 CalDAV / CardDAV 认证
ICLOUD_ACCOUNT_1=your-name@icloud.com
# App 专用密码：https://appleid.apple.com 生成，格式 xxxx-xxxx-xxxx-xxxx
ICLOUD_APP_PASSWORD_1=abcd-efgh-ijkl-mnop
# 邮件收发身份（IMAP/SMTP 认证）。留空则与 ICLOUD_ACCOUNT_1 相同
# ICLOUD_SENDER_1=your-alias@icloud.com
# 展示名，多账号时便于区分
# ICLOUD_LABEL_1=personal

# ---- 权限：读缺省开启，写缺省关闭 ----
ALLOW_MAIL_READ_1=true
ALLOW_MAIL_WRITE_1=false
ALLOW_CALENDAR_READ_1=true
ALLOW_CALENDAR_WRITE_1=false
ALLOW_REMINDERS_READ_1=true
ALLOW_REMINDERS_WRITE_1=false
ALLOW_CONTACTS_READ_1=true
ALLOW_CONTACTS_WRITE_1=false

# ---- 账号 2-5（可选，后缀 _2 .. _5）----
# ICLOUD_ACCOUNT_2=
# ICLOUD_APP_PASSWORD_2=

# ---- 运行参数 ----
SESSION_TTL_MINUTES=30
IMAP_IDLE_TIMEOUT_SECONDS=300
LOG_LEVEL=info

# ---- 仅远程 HTTP 入口（dist/bin/http.js）需要 ----
# 本地 stdio 入口（dist/bin/stdio.js，上面的一切）完全不读这五个变量，不填也能正常启动。
# 只有做 README「远程部署」一节里的公网部署时才需要——见该节生成密钥材料的两条命令。
# PUBLIC_URL=https://mcp.example.com
# ADMIN_PASSWORD_HASH=scrypt$32768$8$1$<salt>$<hash>
# TOKEN_ENCRYPTION_KEY=<32 字节密钥的 base64 编码>
# PORT=17733
# TOKEN_STORE_PATH=./data/tokens.json.enc
