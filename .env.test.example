# 复制为 .env.test 后填入真实凭据，才会运行集成测试（npm run test:integration）。
# 集成测试只操作下面指定的专用资源，不会碰你的日常邮件、日历与提醒事项。
ICLOUD_ACCOUNT_1=your-name@icloud.com
ICLOUD_APP_PASSWORD_1=abcd-efgh-ijkl-mnop
# IMAP/SMTP 用它认证，CalDAV 用 ICLOUD_ACCOUNT_1 认证——如果 Apple ID 不是
# iCloud 邮箱（比如用 Gmail 登录的账号），不设置这个会导致 IMAP 测试报
# AUTHENTICATIONFAILED，看起来像是 App 专用密码失效，其实只是发信身份不对。
# ICLOUD_SENDER_1=your-name@icloud.com
ALLOW_MAIL_READ_1=true
ALLOW_MAIL_WRITE_1=false
ALLOW_CALENDAR_READ_1=true
ALLOW_CALENDAR_WRITE_1=true
ALLOW_REMINDERS_READ_1=true
ALLOW_REMINDERS_WRITE_1=true
ALLOW_CONTACTS_READ_1=true
ALLOW_CONTACTS_WRITE_1=true
# 写操作只允许发生在这个日历上，必须先在 iCloud 中手动创建
INTEGRATION_CALENDAR_NAME=MCP-Test
# 写操作只允许发生在这个提醒列表上，必须先在 iCloud 提醒事项中手动创建
INTEGRATION_REMINDER_LIST_NAME=MCP-Test
# 通讯录没有「专用通讯簿」这种隔离手段，改用姓名前缀隔离：测试只创建、修改、
# 删除 FN 以这个前缀开头的联系人，删除前会重新确认前缀
INTEGRATION_CONTACT_PREFIX=MCP-Test-
