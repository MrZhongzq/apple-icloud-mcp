# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets
# The default TOKEN_STORE_PATH is ./data/tokens.json.enc, and the README tells
# people to run exactly that way for local testing -- so `git add -A` after one
# local run would otherwise commit the encrypted OAuth client/token database into
# history, where it is unrecoverable and decryptable by anyone who later gets
# TOKEN_ENCRYPTION_KEY. .dockerignore already excludes `data` for the same reason.
data/
.env
.env.*
!.env.example
!.env.test.example
.env.test
*.pem
*.key
*.crt

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# AI agent local state
.gemini/
.claude/settings.local.json

# Misc
tmp/
temp/
*.local
